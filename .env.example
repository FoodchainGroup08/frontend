# Copy this file to .env and fill in your values.

# Backend REST API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080/api

# Backend WebSocket base URL (no trailing slash, no path)
VITE_WS_BASE_URL=ws://localhost:8080

# Optional: Google Maps API key for address autocomplete in Checkout
# Leave blank to use the built-in demo Lagos locations list instead
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID (from Google Cloud Console → Credentials)
# Add http://localhost:5173 as an Authorized JavaScript Origin for local dev
VITE_GOOGLE_CLIENT_ID=
