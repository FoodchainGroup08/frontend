# Copy this file to .env and fill in your values.

# Backend REST API host (no trailing slash, no /api/v1 suffix)
VITE_API_URL=http://localhost:8080

# Backend WebSocket host (no trailing slash)
VITE_WS_URL=ws://localhost:8080

# Optional: Google Maps API key for address autocomplete in Checkout
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID
# Add http://localhost:5173 as an Authorized JavaScript Origin for local dev
VITE_GOOGLE_CLIENT_ID=
